# Copia a .env.local para desarrollo. En Vercel se definen en Project Settings → Environment Variables.

# Base de la API FastAPI, usada por el servidor de Next (Server Components, Server Actions, proxy.ts).
# Local: uvicorn (8000) o el servicio api de docker-compose (8001). Producción: la URL https://...run.app
# del servicio de Cloud Run, terminada en /api/v1.
API_BASE_URL=http://localhost:8001/api/v1

# La misma base, expuesta al navegador: sólo para el XHR de subida de video y el <video src> (§5.4, §6).
# NEXT_PUBLIC_* se incrusta en el build: cambiarla en Vercel exige un redeploy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
