# Copia a .env.local para desarrollo. En Vercel se definen en Project Settings → Environment Variables.

# Backend gRPC: URL pública de Envoy (gRPC-Web sobre HTTP/1.1), sin barra final. La usa solo el servidor
# de Next; el navegador nunca habla con el backend. Local: docker run -e PORT=10000 -p 10000:10000 del
# backend. Render (Frankfurt): https://kinesiapp-backend-grpc.onrender.com
GRPC_WEB_BASE_URL=http://localhost:10000
# Deadline por defecto de cada RPC simple, en milisegundos (opcional, 30000 si no se define)
GRPC_TIMEOUT_MS=30000
# Deadline de los streams (progreso del análisis y chat), por debajo del maxDuration de Vercel (opcional, 240000)
GRPC_STREAM_TIMEOUT_MS=240000
# Espera máxima de WakeUpAi con la IA en frío (opcional, 60000)
AI_WAKE_UP_TIMEOUT_MS=60000

# Opcionales del servidor (el valor es el default)
# Origen público para el sitemap y la metadata; en Vercel se deduce del despliegue si no se define
SITE_ORIGIN=
# Tamaño de página de los listados; el backend no entrega más de 50
LIST_PAGE_SIZE=50
# Segundos antes del vencimiento en que se renueva el access token
ACCESS_REFRESH_LEEWAY_SECONDS=60
# Vida de la cookie que pide despertar la IA al entrar
AI_WAKE_COOKIE_MAX_AGE_SECONDS=60

# Opcionales públicas (el valor es el default). Next las incrusta en el bundle al construir: cambiarlas
# pide redesplegar. Los límites del video, la contraseña y los rangos no van aquí: llegan por GetClientPolicy
# Zona IANA para formatear fechas en el servidor y en el navegador
NEXT_PUBLIC_APP_TIME_ZONE=America/Bogota
# Margen antes de que venza la URL firmada del video para pedir otra
NEXT_PUBLIC_VIDEO_URL_RENEW_MARGIN_MS=5000
# Espera entre reenvíos del código OTP (solo UX: el backend decide)
NEXT_PUBLIC_OTP_RESEND_COOLDOWN_SECONDS=30
# Vida de las cookies de idioma y tema (un año)
NEXT_PUBLIC_PREFERENCE_COOKIE_MAX_AGE_SECONDS=31536000
# Estado de la IA: cuánto vale un "IA activada", cuándo se da por perdido un "encendiendo" y los reintentos
NEXT_PUBLIC_AI_READY_TTL_MS=240000
NEXT_PUBLIC_AI_WAKE_STALE_MS=90000
NEXT_PUBLIC_AI_WARMING_RETRY_MS=3000
NEXT_PUBLIC_AI_WARMING_ATTEMPTS=20
# Cuánto antes y después del pico de riesgo se dibuja el esqueleto sobre el video
NEXT_PUBLIC_RISK_POSE_WINDOW_MS=250

# Cuenta de demostración para la evaluación (opcionales): con las dos, el login sale prellenado. Solo las lee
# la página de login en el servidor. Se quitan cuando termine la evaluación.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
