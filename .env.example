# Copia a .env.local para desarrollo. En Vercel se definen en Project Settings → Environment Variables.

# Backend gRPC: URL pública de Envoy (gRPC-Web sobre HTTP/1.1), sin barra final. La usa solo el servidor
# de Next; el navegador nunca habla con el backend. Local: docker run -e PORT=10000 -p 10000:10000 del
# backend. Render (Frankfurt): https://kinesiapp-backend-grpc.onrender.com
GRPC_WEB_BASE_URL=http://localhost:10000
# Deadline por defecto de cada RPC simple, en milisegundos (opcional, 30000 si no se define)
GRPC_TIMEOUT_MS=30000
# Deadline de los streams (progreso del análisis y chat), por debajo del maxDuration de Vercel (opcional, 240000)
GRPC_STREAM_TIMEOUT_MS=240000
# Espera máxima de WakeUpAi con la IA en frío (opcional, 60000)
AI_WAKE_UP_TIMEOUT_MS=60000

# Zona IANA para formatear fechas en el servidor (opcional, America/Bogota)
APP_TIME_ZONE=America/Bogota

# Cuenta de demostración para la evaluación (opcionales): con las dos, el login sale prellenado. Solo las lee
# la página de login en el servidor. Se quitan cuando termine la evaluación.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
