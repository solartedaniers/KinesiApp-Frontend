{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "buf generate",
    "vendor": "node -e \"require('node:fs').cpSync('node_modules/pdf-lib/dist/pdf-lib.esm.min.js', 'public/vendor/pdf-lib.esm.min.js')\"",
    "predev": "npm run generate && npm run vendor",
    "dev": "next dev",
    "prebuild": "npm run generate && npm run vendor",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "npm run vendor",
    "test": "node --test --experimental-transform-types --no-warnings=ExperimentalWarning \"lib/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
